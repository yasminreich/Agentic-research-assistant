# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Explicit types for files Git shouldn't guess at.
*.py    text diff=python
*.md    text
*.html  text diff=html
*.svg   text
*.yml   text
*.yaml  text

# Binary — never diff or normalize.
*.docx  binary
*.png   binary
*.jpg   binary
*.pdf   binary
