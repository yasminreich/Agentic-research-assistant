# Copy to `.env` and fill in. Never commit the real .env.

# Required: Anthropic API key for the Researcher Agent (Claude).
ANTHROPIC_API_KEY=

# Optional: your email enables OpenAlex's faster "polite pool". OpenAlex is the
# Paperclip backend and needs no API key at all; this is purely a courtesy that
# improves throughput. Leave blank to use the common pool.
OPENALEX_MAILTO=

# Claude model. Default is the most capable Opus-tier model.
CLAUDE_MODEL=claude-opus-4-8

# Only consider papers published in this year or later.
MIN_YEAR=2015

# Max papers requested per individual search query (OpenAlex caps at 200).
MAX_PAPERS_PER_QUERY=50

# Safety cap on the number of automatic agent turns per research run.
MAX_AGENT_TURNS=15

# Where generated reports are written.
OUTPUT_DIR=output
